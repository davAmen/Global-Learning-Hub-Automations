# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Supabase (required — get from supabase.com → Project Settings → API)
SUPABASE_URL=
SUPABASE_KEY=

# Which channel sends reminders: whatsapp | telegram | email | sms
ACTIVE_CHANNEL=whatsapp
BACKUP_CHANNEL=telegram

# WasenderAPI (wasenderapi.com) — ACTIVE channel
# Get your API key from https://wasenderapi.com/dashboard
WASENDER_API_KEY=
# Optional: if you use a different base URL
WASENDER_BASE_URL=https://www.wasenderapi.com
# Webhook secret for verifying WasenderAPI webhooks (SEPARATE from API key!)
# Generate with: openssl rand -hex 32
WASENDER_WEBHOOK_SECRET=

# Telegram Bot API — BACKUP channel
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Administrator contact for daily reports
ADMIN_EMAIL=
ADMIN_PHONE=

# Sending behavior
RATE_LIMIT_DELAY_SECONDS=6
JOB_HOUR=8
JOB_MINUTE=0

# IELTS-specific settings (can be overridden in .env)
IELTS_COURSE_NAME=IELTS Preparation (Oct 15-30, 6-8pm GMT)
IELTS_ANNOUNCEMENT_GROUP_JID=120363418173591450@g.us
IELTS_PROOF_GROUP_JID=120363428841556134@g.us
IELTS_CLASS_ACCESS_GROUP_JID=120363413380837553@g.us
IELTS_PROOF_GROUP_URL=https://chat.whatsapp.com/IPtb2v6EzQUJ6LGLrObDrw
IELTS_CLASS_ACCESS_GROUP_URL=https://chat.whatsapp.com/HZpPBTfKDQq7aVYOgpUFkw
IELTS_START_DATE=2026-10-15
IELTS_END_DATE=2026-10-30
IELTS_CLASS_TIME=18:00-20:00 GMT
IELTS_MOMO_NUMBER=+233548014157
IELTS_TELECEL_NUMBER=+23333206967251
IELTS_REFERENCE=ILETS
IELTS_AMOUNT=100.0
IELTS_CURRENCY=GHS

# Feature flags
AUTO_APPROVE_REMINDERS=false
ENABLE_IELTS_REMINDERS=true

# Payment providers
# Paystack (paystack.com) - Get keys from dashboard.paystack.com
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# SeefCash (seefcash.com) - Get keys from provider dashboard
SEEFCASH_PUBLIC_KEY=
SEEFCASH_SECRET_KEY=
SEEFCASH_WEBHOOK_SECRET=

# Stripe (stripe.com) - Get keys from dashboard.stripe.com
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# JWT Authentication - Generate with: openssl rand -hex 32
JWT_SECRET_KEY=

# App base URL for payment callbacks
APP_BASE_URL=http://localhost:3000