# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Supabase (required — get from supabase.com → Project Settings → API)
SUPABASE_URL=
SUPABASE_KEY=

# Which channel sends reminders: whatsapp | telegram | email | sms
ACTIVE_CHANNEL=whatsapp
BACKUP_CHANNEL=telegram

# WhatsApp Business Cloud API (Meta) — ACTIVE channel
# Get these from developers.facebook.com → WhatsApp → Quickstart
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Telegram Bot API — BACKUP channel
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Administrator contact for daily reports
ADMIN_EMAIL=
ADMIN_PHONE=

# Sending behavior
RATE_LIMIT_DELAY_SECONDS=60
JOB_HOUR=8
JOB_MINUTE=0
