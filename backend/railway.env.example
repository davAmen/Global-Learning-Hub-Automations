# Railway Environment Variables
# Copy these to Railway Dashboard → Variables

# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# WasenderAPI (required)
WASENDER_API_KEY=your-wasender-api-key
WASENDER_BASE_URL=https://www.wasenderapi.com

# Active channel
ACTIVE_CHANNEL=whatsapp
BACKUP_CHANNEL=telegram

# Telegram (backup channel - optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Admin contact for daily reports
ADMIN_EMAIL=amenukudavid20@gmail.com
ADMIN_PHONE=+233548014157

# Scheduler settings
JOB_HOUR=8
JOB_MINUTE=0
RATE_LIMIT_DELAY_SECONDS=6

# Timezone (for 5am GMT IELTS reminders)
TZ=GMT