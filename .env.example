# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Everything here is a PLACEHOLDER — never put a real key in this file.

# Supabase (required even in dry-run tests, use a test project key)
SUPABASE_URL=
SUPABASE_KEY=

# Which single channel Phase 1 sends through: sms | email | whatsapp
ACTIVE_CHANNEL=email

# Email channel (active) — SMTP credentials
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_API_KEY=

# Administrator contact for the daily report
ADMIN_EMAIL=
ADMIN_PHONE=

# Other channels — not wired in Phase 1, leave blank
SMS_API_KEY=
WHATSAPP_API_KEY=

# Sending behavior
# Minutes between sends to different students (prevents throttling/bans)
RATE_LIMIT_DELAY_MINUTES=1
# Scheduler hour (24h) the daily job fires on the always-on host
JOB_HOUR=8
