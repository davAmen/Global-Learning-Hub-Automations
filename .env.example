# Copy to .env locally. Never commit real secrets.
SUPABASE_URL=
SUPABASE_KEY=
ADMIN_API_KEY=

ACTIVE_CHANNEL=whatsapp
BACKUP_CHANNEL=telegram
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Keep the Graph API version configurable so upgrades do not require code edits.
WHATSAPP_GRAPH_VERSION=v23.0
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_API_KEY=
ADMIN_EMAIL=
ADMIN_PHONE=
SMS_API_KEY=

# Ghana is the operational default.
TIMEZONE=Africa/Accra
# Disabled by default to avoid duplicate jobs when an app is deployed with
# multiple web workers. Prefer a hosted cron calling POST /run-daily-job.
ENABLE_SCHEDULER=false
RATE_LIMIT_DELAY_SECONDS=1
JOB_HOUR=8
JOB_MINUTE=0
