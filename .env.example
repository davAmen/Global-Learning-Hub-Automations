# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Everything here is a PLACEHOLDER — never put a real key in this file.

# Supabase (use a separate test project until a controlled pilot is authorized)
SUPABASE_URL=
SUPABASE_KEY=
ADMIN_API_KEY=

# Phase 1 primary and backup
ACTIVE_CHANNEL=whatsapp
BACKUP_CHANNEL=telegram
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Inactive email adapter
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_API_KEY=

# Administrator contact for the daily report
ADMIN_EMAIL=
ADMIN_PHONE=

# Inactive SMS adapter
SMS_API_KEY=

# Sending behavior
# Minutes between sends to different students (prevents throttling/bans)
RATE_LIMIT_DELAY_SECONDS=60
# Scheduler hour (24h) the daily job fires on the always-on host
JOB_HOUR=8
JOB_MINUTE=0
